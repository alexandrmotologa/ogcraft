{
  "id": "product_launch",
  "name": "Product Launch Announcement",
  "description": "Bold presentation for SaaS product launches, version releases, and changelog highlights",
  "width": 1200,
  "height": 630,
  "background": {
    "type": "gradient",
    "direction": "to-bottom-right",
    "stops": [
      { "offset": 0.0, "color": "#0b0f19" },
      { "offset": 1.0, "color": "#1e1b4b" }
    ]
  },
  "elements": [
    {
      "type": "badge",
      "field": "tag",
      "default": "NOW AVAILABLE v2.0",
      "icon": "bolt",
      "font": "Inter-Bold",
      "font_size": 20,
      "color": "#ffffff",
      "background_color": "#4f46e5",
      "x": 80,
      "y": 80,
      "padding_x": 16,
      "padding_y": 8,
      "border_radius": 8
    },
    {
      "type": "text",
      "field": "title",
      "default": "Introducing FastEdge: Instant Edge Worker Deployment in Under 50ms",
      "font": "Inter-Bold",
      "font_size": 56,
      "color": "#ffffff",
      "x": 80,
      "y": 160,
      "max_width": 1040,
      "line_height": 1.25,
      "max_lines": 3,
      "fit_text": true
    },
    {
      "type": "text",
      "field": "description",
      "default": "Deploy distributed worker functions across 300+ edge locations with zero cold start penalty.",
      "font": "Inter-Regular",
      "font_size": 28,
      "color": "#cbd5e1",
      "x": 80,
      "y": 380,
      "max_width": 1040,
      "line_height": 1.3,
      "max_lines": 2,
      "fit_text": true
    },
    {
      "type": "badge",
      "field": "cta",
      "default": "Read Launch Notes",
      "font": "Inter-SemiBold",
      "font_size": 22,
      "color": "#0f172a",
      "background_color": "#38bdf8",
      "x": 80,
      "y": 490,
      "padding_x": 20,
      "padding_y": 12,
      "border_radius": 10
    },
    {
      "type": "text",
      "field": "author",
      "default": "mtlglabs.space",
      "font": "Inter-Medium",
      "font_size": 24,
      "color": "#94a3b8",
      "x": 340,
      "y": 506
    }
  ]
}
