      "border_color": "#cbd5e1",
      "border_width": 2
    },
    {
      "type": "text",
      "field": "author",
      "default": "Alexandr Motologa",
      "font": "Inter-SemiBold",
      "font_size": 26,
      "color": "#1e293b",
      "x": 164,
      "y": 516
    },
    {
      "type": "text",
      "field": "date",
      "default": "mtlglabs.space",
      "font": "Inter-Regular",
      "font_size": 22,
      "color": "#64748b",
